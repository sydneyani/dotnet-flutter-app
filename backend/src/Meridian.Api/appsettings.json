{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=meridian.db"
  },
  "Jwt": {
    "Issuer": "meridian",
    "Audience": "meridian-mobile",
    "SigningKey": "dev-only-meridian-signing-key-change-me",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 14
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": "Meridian#demo1"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
